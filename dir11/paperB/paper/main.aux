\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Thermal-drift, ring-mismatch, and splitting tolerances of the acoustic design at the AO operating point (simulation; \texttt  {data/tol\_scan.csv}). $\eta _{\rm  shift}$ versus the common detuning $\Delta $ of the laser from both rings, the ring-2--ring-1 resonance mismatch $\delta _r$, and the splitting error $2\mu -\Omega _m$; the two-dimensional map shows the ridge along $\Delta \approx \delta _r/2$. Temperature axes use $|df/dT|\approx 2.8$~GHz/K (thermo-optic effect only); including thermal expansion ($\approx 5.6$~GHz/K) halves all temperature windows (see text).}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:thermal}{{4}{5}{Thermal-drift, ring-mismatch, and splitting tolerances of the acoustic design at the AO operating point (simulation; \texttt {data/tol\_scan.csv}). $\etash $ versus the common detuning $\Delta $ of the laser from both rings, the ring-2--ring-1 resonance mismatch $\delta _r$, and the splitting error $2\mu -\Omega _m$; the two-dimensional map shows the ridge along $\Delta \approx \delta _r/2$. Temperature axes use $|df/dT|\approx 2.8$~GHz/K (thermo-optic effect only); including thermal expansion ($\approx 5.6$~GHz/K) halves all temperature windows (see text)}{figure.4}{}}
