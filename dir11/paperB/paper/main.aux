\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Realistic-condition Monte Carlo of the acoustic design (simulation, $N=1000$; \texttt  {data/mc\_samples.csv}, \texttt  {data/realistic\_summary.json}) with the parameters of Table~\ref {tab:real}: distributions of $\eta _{\rm  shift}$, on-chip IL, and on-chip and fiber-to-fiber absolute efficiency, together with one-at-a-time sensitivity scans of the assumed parameters (each scan point drawn independently with $N=300$, statistical error $\approx \pm 0.005$ in the median; trends only). The ideal operating point ($\eta _{\rm  shift}=98.3\%$) is an upper bound.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:mc}{{5}{6}{Realistic-condition Monte Carlo of the acoustic design (simulation, $N=1000$; \texttt {data/mc\_samples.csv}, \texttt {data/realistic\_summary.json}) with the parameters of Table~\ref {tab:real}: distributions of $\etash $, on-chip IL, and on-chip and fiber-to-fiber absolute efficiency, together with one-at-a-time sensitivity scans of the assumed parameters (each scan point drawn independently with $N=300$, statistical error $\approx \pm 0.005$ in the median; trends only). The ideal operating point ($\etash =98.3\%$) is an upper bound}{figure.5}{}}
