\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Purity versus length, rerun at $-3.161$~rad/mm/nm. Each entry is the median and the 10th--90th percentile over 16 draws. Purity does not depend on loss. Heralding efficiency and coincidence rate are in Table~\ref {tab:rate}, not here. The 0.5~nm measurement-error column of the previous scan was not repeated and is not shown. The 0.04~mm pitch is assumed. Ideal purities in this run round to 0.994 at every length.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:mc}{{4}{6}{Purity versus length, rerun at $-3.161$~rad/mm/nm. Each entry is the median and the 10th--90th percentile over 16 draws. Purity does not depend on loss. Heralding efficiency and coincidence rate are in Table~\ref {tab:rate}, not here. The 0.5~nm measurement-error column of the previous scan was not repeated and is not shown. The 0.04~mm pitch is assumed. Ideal purities in this run round to 0.994 at every length}{table.4}{}}
